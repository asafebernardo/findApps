<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>br.com.findapps.FindApps</id>
  <name>FindApps</name>
  <summary>Gerenciador universal de aplicativos Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      O FindApps é um gerenciador universal de aplicativos para Linux.
      Ele detecta programas instalados via APT, DNF, Flatpak, Snap, AppImage
      e instalações manuais, permitindo visualizar, pesquisar e desinstalar
      com segurança.
    </p>
  </description>
  <launchable type="desktop-id">br.com.findapps.FindApps.desktop</launchable>
  <url type="homepage">https://github.com/asafebernardo/findApps</url>
  <provides>
    <binary>findapps</binary>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-08-11">
      <description>
        <p>Primeiro MVP: listagem, pesquisa, filtros, detalhes e desinstalação.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
</component>
